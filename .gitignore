# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Build directory (ignore everything except release APKs)
/build/*
!/build/app/
/build/app/*
!/build/app/outputs/
/build/app/outputs/*
!/build/app/outputs/apk/
/build/app/outputs/apk/*
!/build/app/outputs/apk/release/
/build/app/outputs/apk/release/*
!/build/app/outputs/apk/release/*.apk
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local scratch notes for GitHub issues (not for commit)
/issues/

# Generated localizations (regenerated by flutter gen-l10n; ARB files are the source)
/lib/l10n/app_localizations*.dart

# web
/web/

# Kotlin compiler cache
/android/.kotlin/
# Widget Preview related
.widget_preview/
